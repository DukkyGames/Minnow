{
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": ["$minnow:typescript-language-server"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"],
      "defaultEnabled": true,
      "label": "TypeScript/JavaScript"
    },
    "pyright": {
      "disabled": false,
      "command": ["$minnow:pyright-langserver"],
      "extensions": [".py", ".pyi"],
      "defaultEnabled": true,
      "label": "Pyright"
    },
    "html": {
      "disabled": false,
      "command": ["$minnow:vscode-html-language-server"],
      "extensions": [".html", ".htm"],
      "defaultEnabled": true,
      "label": "HTML"
    },
    "css": {
      "disabled": false,
      "command": ["$minnow:vscode-css-language-server"],
      "extensions": [".css", ".scss", ".less"],
      "defaultEnabled": true,
      "label": "CSS"
    },
    "graphql": {
      "disabled": false,
      "command": ["$minnow:graphql-lsp"],
      "extensions": [".graphql", ".gql"],
      "defaultEnabled": true,
      "label": "GraphQL"
    },
    "yaml-ls": {
      "disabled": false,
      "command": ["$minnow:yaml-language-server"],
      "extensions": [".yaml", ".yml"],
      "defaultEnabled": true,
      "label": "YAML"
    },
    "bash": {
      "disabled": false,
      "command": ["$minnow:bash-language-server"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"],
      "defaultEnabled": true,
      "label": "Bash"
    },
    "dockerfile": {
      "disabled": false,
      "command": ["$minnow:docker-langserver"],
      "extensions": [".dockerfile", "Dockerfile"],
      "defaultEnabled": true,
      "label": "Dockerfile"
    },
    "rust": {
      "disabled": true,
      "command": ["rust-analyzer"],
      "extensions": [".rs"],
      "defaultEnabled": false,
      "label": "Rust Analyzer",
      "requirements": { "binary": "rust-analyzer" }
    },
    "gopls": {
      "disabled": true,
      "command": ["gopls"],
      "extensions": [".go"],
      "defaultEnabled": false,
      "label": "gopls",
      "requirements": { "command": "go" }
    },
    "clangd": {
      "disabled": true,
      "command": ["clangd", "--background-index", "--clang-tidy"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".c++", ".h", ".hpp", ".hh", ".hxx", ".h++"],
      "defaultEnabled": false,
      "label": "clangd",
      "requirements": { "binary": "clangd" }
    },
    "lua-ls": {
      "disabled": true,
      "command": ["lua-language-server"],
      "extensions": [".lua"],
      "defaultEnabled": false,
      "label": "Lua",
      "requirements": { "binary": "lua-language-server" }
    },
    "terraform": {
      "disabled": true,
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"],
      "defaultEnabled": false,
      "label": "Terraform",
      "requirements": { "binary": "terraform-ls" }
    },
    "zls": {
      "disabled": true,
      "command": ["zls"],
      "extensions": [".zig", ".zon"],
      "defaultEnabled": false,
      "label": "Zig (zls)",
      "requirements": { "command": "zig" }
    },
    "fake": {
      "disabled": false,
      "command": ["node", "test/fixtures/fake-lsp.mjs"],
      "extensions": [".fake"],
      "defaultEnabled": true,
      "label": "Fake LSP (tests)"
    }
  }
}
