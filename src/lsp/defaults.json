{
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"],
      "defaultEnabled": true,
      "label": "TypeScript/JavaScript"
    },
    "eslint": {
      "disabled": true,
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts", ".vue"],
      "defaultEnabled": false,
      "label": "ESLint",
      "requirements": { "package": "eslint" }
    },
    "oxlint": {
