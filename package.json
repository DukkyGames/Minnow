{
  "name": "speedchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-skills-manifest.mjs",
    "build": "tsc && vite build",
    "postinstall": "node scripts/sync-impeccable-skill.mjs",
    "impeccable:sync": "node scripts/sync-impeccable-skill.mjs",
    "impeccable:update": "npx impeccable skills update && node scripts/sync-impeccable-skill.mjs",
    "impeccable:detect": "npx impeccable detect src/ index.html",
    "test:skills": "tsx --test test/skills-loader.test.ts",
    "test:attachments": "tsx --test test/workspace-ref.test.ts",
    "test:skills-impeccable": "node --test test/skills-impeccable.test.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test test/config/*.test.js test/providers/*.test.js test/prompts/*.test.js test/cdp/*.test.js test/browser-cdp.test.mjs test/skills-impeccable.test.mjs test/memory/*.test.mjs test/lsp/*.test.mjs test/mcp/*.test.mjs && tsx --test test/file/*.test.mjs test/self-healing/**/*.test.mts test/ui-designer/**/*.test.mts test/ui/*.test.mjs test/prompts/*.test.mjs test/titles/*.test.mjs test/modes/*.test.mts test/experts/**/*.test.mjs test/work-agents/**/*.test.mjs test/sub-agents/**/*.test.mts test/skills-loader.test.ts test/workspace-ref.test.ts",
    "test:memory": "node --test test/memory/*.test.mjs",
    "test:lsp": "node --test test/lsp/*.test.mjs",
    "test:mcp": "node --test test/mcp/*.test.mjs",
    "test:ui-designer": "tsx --test test/ui-designer/**/*.test.mts && node scripts/step15-smoke.mjs",
    "test:browser": "node --test test/cdp/*.test.js test/browser-cdp.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-types": "^3.17.5",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "happy-dom": "^15.11.7",
    "impeccable": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "pdf-parse": "^1.1.4"
  }
}
