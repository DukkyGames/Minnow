{
  "name": "speedchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test test/config/*.test.js test/providers/*.test.js test/prompts/*.test.js test/file/*.test.mjs && tsx --test test/ui/*.test.mjs test/prompts/*.test.mjs test/titles/*.test.mjs test/modes/*.test.mts test/experts/**/*.test.mjs test/work-agents/**/*.test.mjs test/sub-agents/**/*.test.mts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "happy-dom": "^15.11.7",
    "tsx": "^4.19.2",
