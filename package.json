{
  "name": "minnow",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first AI chat client for LM Studio and OpenAI-compatible providers",
  "author": "Grim Media",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "electron/dist/main.js",
  "bin": {
    "minnow": "./bin/minnow.mjs"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-skills-manifest.mjs && tsx scripts/generate-settings-registry.mjs",
    "build:benchmark-packs": "node scripts/build-benchmark-packs.mjs",
    "report:bundle-size": "node scripts/report-bundle-size.mjs",
    "report:bundle-size:ci": "node scripts/report-bundle-size.mjs --fail-over-kb 1500",
    "build": "tsc && vite build",
    "postinstall": "node scripts/sync-impeccable-skill.mjs && node scripts/ensure-electron.mjs",
    "app-icon:sync": "node scripts/sync-app-icon.mjs && node scripts/brand-electron-win.mjs",
    "impeccable:sync": "node scripts/sync-impeccable-skill.mjs",
    "impeccable:update": "npx impeccable skills update && node scripts/sync-impeccable-skill.mjs",
    "impeccable:detect": "npx impeccable detect src/ index.html",
    "index-html:coupling-map": "node scripts/index-html-coupling-map.mjs",
    "caveman:sync": "node scripts/sync-caveman-skill.mjs",
    "matt-pocock-skills:sync": "node scripts/sync-matt-pocock-skills.mjs",
    "settings-registry:generate": "tsx scripts/generate-settings-registry.mjs",
    "matt-pocock-skills:update": "node scripts/sync-matt-pocock-skills.mjs",
    "test": "node test/run-all.mjs",
    "test:check-coverage": "node test/check-test-coverage.mjs",
    "test:skills": "node test/run-all.mjs --suite skills",
    "test:attachments": "node test/run-all.mjs --suite attachments",
    "test:skills-impeccable": "node test/run-all.mjs --suite skills-impeccable",
    "test:impeccable": "node test/run-all.mjs --suite impeccable",
    "preview": "vite preview",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "concurrently -k -n server,electron \"cross-env BROWSER=none MINNOW_ELECTRON=1 node server.js\" \"node scripts/electron-dev.mjs\"",
    "desktop": "npm run electron:dev",
    "electron:prod": "npm run build && npm run electron:build && cross-env MINNOW_ELECTRON=1 electron electron/dist/main.js",
    "package:clean": "node scripts/clean-release.mjs",
    "prepackage": "node scripts/clean-release.mjs && node scripts/validate-packaged-runtime-files.mjs",
    "prepackage:dir": "node scripts/clean-release.mjs && node scripts/validate-packaged-runtime-files.mjs",
    "package": "npm run build && npm run electron:build && node scripts/electron-builder-run.mjs",
    "package:dir": "npm run build && npm run electron:build && node scripts/electron-builder-run.mjs --dir",
    "package:win": "npm run build && npm run electron:build && node scripts/electron-builder-run.mjs --win",
    "package:mac": "npm run build && npm run electron:build && node scripts/electron-builder-run.mjs --mac",
    "start": "node server.js",
    "minnow:run": "node bin/minnow.mjs run",
    "test:notifications": "node test/run-all.mjs --suite notifications",
    "test:calendar": "node test/run-all.mjs --suite calendar",
    "test:email": "node test/run-all.mjs --suite email",
    "test:terminal-pty": "node test/terminal/pty-session.test.mjs",
    "test:memory": "node test/run-all.mjs --suite memory",
    "test:brain": "node test/run-all.mjs --suite brain",
    "test:settings": "node test/run-all.mjs --suite settings",
    "test:engine": "node test/run-all.mjs --suite engine",
    "test:lsp": "node test/run-all.mjs --suite lsp",
    "test:mcp": "node test/run-all.mjs --suite mcp",
    "test:research": "node test/run-all.mjs --suite research",
    "test:servers": "node test/run-all.mjs --suite servers",
    "test:webhooks": "node test/run-all.mjs --suite webhooks",
    "test:plugins": "node test/run-all.mjs --suite plugins",
    "test:ui-designer": "node test/run-all.mjs --suite ui-designer",
    "test:design": "node test/run-all.mjs --suite design",
    "test:browser": "node test/run-all.mjs --suite browser",
    "test:benchmark": "node test/run-all.mjs --suite benchmark",
    "test:evals": "node test/run-all.mjs --suite evals"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.5",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-angular": "^0.1.4",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "7.0.11",
    "bash-language-server": "^5.4.2",
    "better-sqlite3": "^12.10.1",
    "connect": "^3.7.0",
    "cron-parser": "^5.5.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff": "^9.0.0",
    "dockerfile-language-server-nodejs": "^0.14.0",
    "dompurify": "^3.1.6",
    "electron-updater": "^6.8.9",
    "graphql-language-service-cli": "^3.3.0",
    "highlight.js": "^11.10.0",
    "imapflow": "^1.4.0",
    "isomorphic-dompurify": "^3.15.0",
    "mailparser": "^3.9.9",
    "marked": "^12.0.2",
    "node-ical": "^0.26.1",
    "nodemailer": "^9.0.0",
    "pyright": "^1.1.400",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "rrule": "^2.8.1",
    "sirv": "^3.0.2",
    "tsdav": "^2.2.2",
    "typescript": "^5.6.3",
    "typescript-language-server": "^4.3.4",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-langservers-extracted": "^4.10.0",
    "vscode-languageserver-types": "^3.17.5",
    "ws": "^8.20.1",
    "yaml-language-server": "^1.15.0"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "hyparquet": "^1.26.0",
    "impeccable": "^3.1.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "tsx": "^4.19.2",
    "vite": "^6.2.5",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "mammoth": "^1.9.0",
    "officeparser": "^7.1.0",
    "pdf-parse": "^1.1.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "org.grimmedia.minnow",
    "productName": "Minnow",
    "publish": {
      "provider": "github",
      "owner": "DukkyGames",
      "repo": "Minnow"
    },
    "directories": {
      "output": "release/pkg"
    },
    "files": [
      "dist/**",
      "electron/dist/**",
      "server/**",
      "src/skills/**",
      "src/chat/prompts/**",
      "src/chat/reef/**",
      "src/lsp/**",
      "src/lib/**",
      "src/attachments/document-extensions.mjs",
      "src/evals/packs/**",
      "build/icon.ico",
      "public/logos/minnow-logo/minnow/png/minnow-1024.png",
      "scripts/generate-skills-manifest.mjs",
      "package.json",
      "skills-lock.json",
      "!**/*.map",
      "!src/**/*.ts",
      "!src/**/*.tsx",
      "!src/**/*.css"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "documentation",
        "to": "documentation"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/logos/minnow-logo/minnow/png/minnow-1024.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
