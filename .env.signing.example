# Copy to .env.signing (gitignored) for signed + notarized macOS releases.
# Never commit real values.

# --- Code signing (optional — electron-builder auto-discovers the first
#     Developer ID Application cert in your login keychain) ---
# CSC_NAME=Henri Grimm (TEAMID)

# --- Notarization — option A: Apple ID + app-specific password ---
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# --- Notarization — option B: App Store Connect API key (CI-friendly) ---
# APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_KEY_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: custom CSR subject when running npm run signing:setup
# MINNOW_SIGNING_CN=Henri Grimm
